---
import Icon from './Icon.astro';
import { films } from '../data/films';
import { YOUTUBE, YOUTUBE_HANDLE } from '../data/site';
---

<section id="films" class="films section" tabindex="-1" aria-labelledby="films-title" data-carousel>
  <div class="section-head">
    <div>
      <p class="eyebrow">03 — FILMS</p>
      <h2 id="films-title">Stories in<br /><em>motion.</em></h2>
    </div>
    <div class="films-controls">
      <a class="text-link" href={YOUTUBE} target="_blank" rel="noopener">YouTube channel <span aria-hidden="true"><Icon name="up-right" /></span></a>
      <div class="carousel-buttons" hidden>
        <button class="carousel-button" type="button" data-carousel-prev aria-label="Previous films" aria-controls="films-track"><span aria-hidden="true"><Icon name="left" /></span></button>
        <button class="carousel-button" type="button" data-carousel-next aria-label="Next films" aria-controls="films-track"><span aria-hidden="true"><Icon name="right" /></span></button>
      </div>
    </div>
  </div>

  <div class="films-carousel">
    <ul class="films-track" id="films-track" tabindex="0" aria-label="Films by Frame OF Love" data-carousel-track>
      {films.map((film) => (
        <li class="film-tile">
          <a
            class="film-tile-link"
            href={`https://www.youtube.com/watch?v=${film.id}`}
            target="_blank"
            rel="noopener"
            data-video-id={film.id}
            data-video-format="film"
            data-video-title={film.fullTitle}
          >
            <img src={`https://i.ytimg.com/vi/${film.id}/maxresdefault.jpg`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <span class="film-tile-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
            <span class="film-tile-text">
              <span class="film-tile-meta">{film.kind} · {film.duration}</span>
              <span class="film-tile-title">{film.title}</span>
              <span class="film-tile-sub">{film.subtitle}</span>
            </span>
          </a>
        </li>
      ))}
      <li class="film-tile film-tile-more">
        <a class="film-tile-link" href={`${YOUTUBE}/videos`} target="_blank" rel="noopener">
          <span class="film-tile-more-mark" aria-hidden="true"><Icon name="up-right" /></span>
          <span class="film-tile-text">
            <span class="film-tile-meta">YouTube</span>
            <span class="film-tile-title">More films on our channel</span>
            <span class="film-tile-sub">{YOUTUBE_HANDLE}</span>
          </span>
        </a>
      </li>
    </ul>
    <div class="films-progress" aria-hidden="true" hidden data-carousel-progress><span></span></div>
  </div>
</section>

<dialog class="video-modal" aria-label="Video player">
  <div class="video-modal-inner">
    <button class="video-modal-close" type="button" aria-label="Close video"><span aria-hidden="true">×</span></button>
    <div class="video-modal-frame"></div>
  </div>
</dialog>
