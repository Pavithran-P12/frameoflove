---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { INSTAGRAM } from '../data/site';
import gallery01 from '../assets/photos/gallery-01.jpg';
import gallery02 from '../assets/photos/gallery-02.jpg';
import gallery03 from '../assets/photos/gallery-03.jpg';
import gallery04 from '../assets/photos/gallery-04.jpg';
import gallery05 from '../assets/photos/gallery-05.jpg';
import gallery06 from '../assets/photos/gallery-06.jpg';
import gallery07 from '../assets/photos/gallery-07.jpg';
import gallery08 from '../assets/photos/gallery-08.jpg';
import gallery09 from '../assets/photos/gallery-09.jpg';

// Shown in this order (the grid fills column by column).
const photos = [
  { src: gallery01, alt: 'Album page titled Harmony: a couple in traditional attire seated beside an antique mirror', label: 'View more album designs on Instagram' },
  { src: gallery02, alt: 'Album page for Prasanth Gopalan and Akhna: the couple close together in warm golden light', label: 'View more couple portraits on Instagram' },
  { src: gallery03, alt: 'Album page titled Sakhi: a woman in a pink silk saree beside a pale wall and red-leaved plants', label: 'View more portraits on Instagram' },
  { src: gallery04, alt: 'Album cover: a couple seated beneath a glowing arch, the bride in a pink lehenga', label: 'View more album designs on Instagram' },
  { src: gallery05, alt: 'Album collage of a bride in a gold saree in a garden, in colour and black and white', label: 'View more album designs on Instagram' },
  { src: gallery06, alt: 'Album page with a Malayalam title: a couple in wedding garlands, the bride in a gold silk saree', label: 'View more wedding photographs on Instagram' },
  { src: gallery07, alt: 'Couple posing beside old weaving looms, the bride in a green and red silk saree', label: 'View more couple portraits on Instagram' },
  { src: gallery08, alt: 'Expectant parents sharing a quiet moment in a sunlit room', label: 'View more maternity photographs on Instagram' },
  { src: gallery09, alt: 'Album page titled Bonding: a couple at a table in a misty field beside a white horse', label: 'View more album designs on Instagram' },
];
---

<section class="gallery section">
  <div class="section-head">
    <div><p class="eyebrow dark">05 — THE GALLERY</p><h2>A collection of<br /><em>little moments.</em></h2></div>
    <a class="text-link" href="/gallery">Open the gallery <span aria-hidden="true"><Icon name="down-right" /></span></a>
  </div>
  <div class="masonry">
    {photos.map((photo) => (
      <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label={photo.label}>
        <Photo src={photo.src} alt={photo.alt} sizes="(max-width: 800px) 50vw, 33vw" widths={[400, 700, 1000]} />
      </a>
    ))}
  </div>
</section>
