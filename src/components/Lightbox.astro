<!-- Full-screen photo viewer for [data-lightbox] links (see src/scripts/main.js). -->
<dialog class="lightbox" aria-label="Photo viewer">
  <div class="lightbox-stage">
    <img class="lightbox-image" alt="" decoding="async" />
  </div>
  <p class="lightbox-caption"><span class="lightbox-title"></span><span class="lightbox-counter" aria-live="polite"></span></p>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous photo"><span aria-hidden="true">←</span></button>
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Next photo"><span aria-hidden="true">→</span></button>
  <button class="video-modal-close lightbox-close" type="button" aria-label="Close photo viewer"><span aria-hidden="true">×</span></button>
</dialog>
