---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import approach from '../assets/photos/approach.jpg';
---

<section class="manifesto">
  <div class="manifesto-image">
    <Photo src={approach} alt="A laughing couple in festive silks, the bride's arm around the groom, framed by soft coloured lights" sizes="(max-width: 800px) 100vw, 50vw" style="object-position: 35% 42%" />
  </div>
  <div class="manifesto-copy">
    <p class="eyebrow">OUR APPROACH</p>
    <h2>Natural.<br />Emotional.<br /><em>Cinematic.</em></h2>
    <p>Beautiful photographs matter. But the photographs that stay with you are the ones that bring the feeling back. Our approach is unobtrusive, intentional and deeply personal.</p>
    <a class="text-link" href="#packages">View packages <span><Icon name="down-right" /></span></a>
  </div>
</section>
