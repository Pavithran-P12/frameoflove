---
import { packages, coverageOptions, additionalServices, paymentTerms } from '../data/packages';
import { whatsapp } from '../data/site';

const rupees = (amount: number) => `₹${amount.toLocaleString('en-IN')}`;
---

<section id="packages" class="packages section" tabindex="-1">
  <div class="section-head">
    <div>
      <p class="eyebrow dark">02 — WEDDING PHOTOGRAPHY PACKAGES</p>
      <h2>Choose your<br /><em>story.</em></h2>
    </div>
    <p>Three packages, each building on the last.<br />Pick the story you want to keep.</p>
  </div>

  <div class="coverage">
    <p class="coverage-label">Every package, two ways</p>
    <div class="coverage-options">
      {coverageOptions.map((option) => <div><strong>{option.name}</strong><span>{option.detail}</span></div>)}
    </div>
  </div>

  <div class="package-grid">
    {packages.map((pkg) => (
      <article class={pkg.featured ? 'package featured' : 'package'}>
        {pkg.featured && <p class="featured-label">Most loved</p>}
        <header class="package-top">
          <span class="package-num">{pkg.num}</span>
          <h3>{pkg.name}</h3>
          <dl class="package-prices">
            {coverageOptions.map((option, i) => (
              <div><dt>{option.name}</dt><dd>{rupees(pkg.prices[i])}</dd></div>
            ))}
          </dl>
          <p class="package-tagline">{pkg.tagline}</p>
          <p class="package-best"><span>Best for</span>{pkg.bestFor}</p>
        </header>
        <div class="package-block">
          <h4>What's included</h4>
          {pkg.included.some((item) => item.isNew) && (
            <p class="package-legend"><span aria-hidden="true">+</span> New in {pkg.name}</p>
          )}
          <ul class={pkg.included.some((item) => item.isNew) ? 'package-list has-new' : 'package-list'}>
            {pkg.included.map((item) => (
              <li class={item.isNew ? 'is-new' : undefined}>
                {item.text}{item.isNew && <span class="visually-hidden"> (new in {pkg.name})</span>}
              </li>
            ))}
          </ul>
        </div>
        <div class="package-block complimentary">
          <h4>With our compliments</h4>
          <ul class="gift-list">
            {pkg.gifts.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <a
          class="package-cta"
          href={whatsapp(`Hi Frame OF Love, I'm interested in the ${pkg.name} package. Please share availability for my dates.`)}
          target="_blank"
          rel="noopener"
        >Ask about {pkg.name} <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
  <p class="package-quote-note">Need a different mix of coverage? <a href={whatsapp("Hi Frame OF Love, I'd like a personalised quote for my wedding.")} target="_blank" rel="noopener">Ask us for a personalised quote ↗</a></p>

  <div class="extras">
    <div><span>+</span><h3>Additional Services</h3></div>
    <p>{additionalServices.join('  ·  ')}</p>
  </div>

  <div class="terms-grid">
    <div><p class="eyebrow dark">PAYMENT TERMS</p><h3>Simple & clear.</h3></div>
    <ul>
      {paymentTerms.map((term) => <li><strong>{term.value}</strong><span>{term.detail}</span></li>)}
    </ul>
  </div>
  <p class="delivery-note">Delivery: 20–30 working days &nbsp;·&nbsp; Travel & accommodation extra outside city limits</p>
</section>
