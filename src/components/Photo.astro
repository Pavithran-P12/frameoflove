---
// A photo from src/assets, resized at build time into several WebP sizes so each
// device downloads only what it needs. Pass `sizes` to describe how wide it is shown.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> & {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
};

const { src, alt, sizes, widths = [480, 800, 1200, 1600, 2400], loading = 'lazy', ...rest } = Astro.props;

// Never upscale: keep the requested widths smaller than the original, plus the original itself.
const usable = [...new Set([...widths.filter((w) => w < src.width), src.width])];
---

<Image src={src} alt={alt} widths={usable} sizes={sizes} loading={loading} decoding="async" {...rest} />
