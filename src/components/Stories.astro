---
import Photo from './Photo.astro';
import story1 from '../assets/photos/story-1.jpeg';
import story2 from '../assets/photos/story-2.jpeg';
import story3 from '../assets/photos/story-3.jpeg';

const stories = [
  { src: story1, alt: 'Album cover titled Venkatesh and Sakthi: the bride twirls in a red lehenga as the groom holds her hand under evening lights', label: '01 / WEDDING', title: 'The beginning of forever', large: true },
  { src: story2, alt: 'Album page reading Stories Written in Light, a smiling couple against a red wall', label: '02 / COUPLE', title: 'In between the moments' },
  { src: story3, alt: 'Black-and-white portrait of a couple kissing, the bride in a sequinned gown and veil', label: '03 / CELEBRATION', title: 'Joy, without direction' },
];
---

<section id="stories" class="stories section" tabindex="-1">
  <div class="section-head">
    <div>
      <p class="eyebrow dark">01 — SELECTED STORIES</p>
      <h2>Stories worth<br /><em>reliving.</em></h2>
    </div>
    <p>Every wedding has its own rhythm.<br />We follow yours.</p>
  </div>

  <div class="story-grid">
    {stories.map((story) => (
      <article class={story.large ? 'story story-large' : 'story'}>
        <Photo src={story.src} alt={story.alt} sizes={story.large ? '(max-width: 800px) 100vw, 58vw' : '(max-width: 800px) 100vw, 30vw'} />
        <div><span>{story.label}</span><h3>{story.title}</h3></div>
      </article>
    ))}
  </div>
</section>
